# ShopSimulator 本地环境配置示例（复制为 .env 后填写；.env 绝不入库）。
# 环境部分：ShopSimulator 不需要任何 API key。
SHOPSIM_BASE_URL=http://127.0.0.1:5700
SHOPSIM_PORT=5700

# ---- 模型连接（仅 live task 需要；全部为占位，必须自行填写）----
# 以下三项只存在于你本地未提交的 .env 中；runner 会把它们映射为
# 固定 DSH commit 的官方 model adapter 实际读取的变量：
#   MODEL_API_KEY  -> DEEPSEEK_API_KEY（dsh 官方 adapter 读取的密钥变量）
#   MODEL_BASE_URL -> DEEPSEEK_BASE_URL（可选 endpoint 覆盖）
# 绝不要把真实 key/endpoint 提交进仓库。
MODEL_BASE_URL=
MODEL_API_KEY=
# MODEL_NAME 记录进 run metadata；与 adapter 的模型选择绑定将在
# profile 的 llm 配置行验证后接入（见 docs/dsh-shopping-plugin.md）。
MODEL_NAME=
