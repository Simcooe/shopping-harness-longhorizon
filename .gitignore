# dsh/ 是独立 clone 的外部依赖（SHA 固定于 DEPENDENCIES.md），不纳入本仓库跟踪
dsh/

node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store

# 本地环境配置（.env 绝不入库；模板为 .env.example）
.env

# shopping plugin 构建产物（源码在 plugins/shopping/src/）
plugins/shopping/lib/

# rollout 运行产物（轨迹 JSONL 不入库；README 保留）
trajectories/*.jsonl
trajectories/**/*.jsonl

# evaluator record（结果证据，运行产物不入库；README 保留）
evaluation/runs/

# baseline 批量结果（运行产物不入库）
evaluation/baselines/
**/evaluation/runs/

# failure evidence bundle（运行产物不入库）
evaluation/evidence/

# candidate / promoted harness（运行产物不入库；README 保留）
harnesses/candidates/*
!harnesses/candidates/README.md
harnesses/promoted/*
!harnesses/promoted/README.md

# live runner 运行时目录（DSH_HOME/CLI/profile 安装；绝不入库）
.live/

# ---- environment/ShopSimulator 运行产物（源码/配置/压缩数据/README/EMBEDDED_SOURCE.json 不忽略）----
environment/ShopSimulator/.venv-shopsim/
environment/ShopSimulator/.venv-shopsim-v2/
environment/ShopSimulator/**/__pycache__/
environment/ShopSimulator/**/*.pyc
environment/ShopSimulator/**/logs/
environment/ShopSimulator/**/cache/
# 生成的搜索索引
environment/ShopSimulator/shop_env/search_engine/
# 解压/生成中的商品数据（压缩源数据 *.json.gz 不忽略）
environment/ShopSimulator/shop_env/data/*.json
environment/ShopSimulator/shop_env/data/*.preparing
# 安装/运行日志
environment/ShopSimulator/**/*.install.log
environment/ShopSimulator/**/shop_agent.log
